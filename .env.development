# Development Environment Configuration
# This file is used when running locally with npm run dev

# API Configuration - Local Backend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# Application Settings
VITE_APP_NAME=Precision Associates (Dev)
VITE_APP_DESCRIPTION=Professional CA Services Platform
VITE_APP_VERSION=1.0.0-dev

# Features
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_DOCUMENTS=true
VITE_ENABLE_SUPPORT=true

# Admin Settings
VITE_ADMIN_BASE_URL=/admin
VITE_ADMIN_DASHBOARD_URL=/admin/dashboard

# Session Settings
VITE_SESSION_TIMEOUT=86400000
VITE_TOKEN_KEY=authToken
VITE_USER_KEY=user

# Debug (Enabled in development)
VITE_DEBUG_MODE=true
VITE_LOG_API_CALLS=true

# Razorpay Configuration (Test Key)
VITE_RAZORPAY_KEY_ID=rzp_test_S8VGOfGXpXIMJV
