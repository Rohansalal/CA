# Production Environment Configuration
# This file is used when building for production deployment on AWS Amplify
# Domain: https://caavinash.in

# API Configuration - Lambda Backend
VITE_API_BASE_URL=https://wybui613ll.execute-api.ap-south-1.amazonaws.com/prod/api
VITE_API_TIMEOUT=30000

# Application Settings
VITE_APP_NAME=Precision Associates
VITE_APP_DESCRIPTION=Professional CA Services Platform
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_DOCUMENTS=true
VITE_ENABLE_SUPPORT=true

# Admin Settings
VITE_ADMIN_BASE_URL=/admin
VITE_ADMIN_DASHBOARD_URL=/admin/dashboard

# Session Settings
VITE_SESSION_TIMEOUT=86400000
VITE_TOKEN_KEY=authToken
VITE_USER_KEY=user

# Debug (Disabled in production)
VITE_DEBUG_MODE=false
VITE_LOG_API_CALLS=false

# Razorpay Configuration
# IMPORTANT: Replace with your production Razorpay key before deploying
